class Solution {
    public ListNode swapPairs(ListNode head) {
        if(head == null)return null;
        if(head.next == null) return head;
        ListNode curr = head;
        while(curr!=null && curr.next!=null){
            int temp = curr.next.val;
            curr.next.val = curr.val;
            curr.val = temp;
            curr = curr.next.next;
        }
        return head;
    }
}
