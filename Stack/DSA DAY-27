class Solution {
    public boolean isValid(String s) {
        Stack<Character> st=new Stack<>();
        if(s.length()==1||s.length()==0){
            return false;
        }
        for(char ch:s.toCharArray()){
            if(ch=='('||ch=='{'||ch=='['){
                st.push(ch);
            }else{

                if(st.isEmpty())
                    return false;

                if(ch==')' && st.peek()!='(')
                    return false;

                if(ch=='}' && st.peek()!='{')
                    return false;

                if(ch==']' && st.peek()!='[')
                    return false;

                st.pop();
            }}
        if(st.size()==0){
            return true;
        }else{
            return false;
        }
        // return false;
    }
}
