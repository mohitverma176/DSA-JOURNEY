class Solution {
    public int search(int[] nums, int target) {
        int lw=0;
        int hi=nums.length-1;
        while(lw<=hi){
            int mid=(lw+hi)/2;
            if(nums[mid]==target){
                return mid;
            }

            else if(nums[mid]>=nums[lw]){
                if(nums[lw]<=target && target<=nums[mid]){
                hi=mid-1;
            }else{
                lw=mid+1;
            }}

            else {
                if(nums[mid]<=target && target<=nums[hi]){
                lw=mid+1;
            }else{
                hi=mid-1;
            }}
                  }
                    return -1;
    }
}
